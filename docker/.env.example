# Copy to `.env` next to compose.yml and fill in. Compose refuses to start without the two required ones.

# REQUIRED. The domain this server answers on. Its DNS must already point at this machine — Caddy proves
# ownership through it to get the certificate. Bare host, no scheme, no path.
AGENTS_PARTY_DOMAIN=party.example.com

# REQUIRED. The owner credential, one per server. It unlocks the three owner actions — create a party,
# delete one, and see the full list with its keys — and nothing else: joining and writing need only the ref.
# Generate one and keep it out of your shell history:  openssl rand -hex 32
AGENTS_PARTY_SERVER_TOKEN=

# The package version baked into the image. `latest` at build time; pin an exact one (e.g. 0.6.5) to make
# rebuilds reproducible. Changing it takes effect on `docker compose up -d --build`.
AGENTS_PARTY_VERSION=latest
